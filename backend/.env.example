# Bu dosyayı ".env" adıyla kopyalayıp düzenleyin. .env dosyası git'e eklenmemeli (gizli anahtar içerir).

# Hangi LLM: "sahte" (anahtarsız, kural tabanlı), "anthropic" ya da "azure_openai"
LLM_SAGLAYICI=sahte
ANTHROPIC_API_KEY=

# Azure OpenAI (LLM_SAGLAYICI=azure_openai iken). Anahtar ve endpoint Azure portalında
# kaynağınızın "Keys and Endpoint" sayfasındadır.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<kaynak-adi>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21

# Anlama tek bir sınıflandırma yaptığı için küçük ve hızlı bir model yeterli.
# Azure OpenAI'da buraya modelin değil, Azure'da oluşturduğunuz DEPLOYMENT'ın adı yazılır.
ANLAMA_MODELI=claude-haiku-5-5
CEVAP_MODELI=claude-haiku-5-5

# LLM (ve Azure TTS) bu kadar saniyede cevap vermezse beklenmez, şablon cümleye / tarayıcı sesine düşülür.
# Açılışta ve arayüz "yapay zekâ bağlantısı var mı" diye sorduğunda da bu süre geçerlidir.
LLM_ZAMAN_ASIMI=6

# 1: serbest yazı/seste görevlinin cümlesini LLM kurar. 0: her zaman şablon.
LLM_CEVAP_ACIK=1

# LLM'e gönderilen konuşma geçmişi (son kaç satır)
GECMIS_UZUNLUGU=8

# Ses servisleri. "yok" = tarayıcının kendi özellikleri kullanılır.
# STT (konuşmayı yazıya çevirme) ve TTS (görevlinin sesi): "yok" ya da "azure".
# STT için tarayıcı sesi 16 kHz WAV'a çevirip sunucuya gönderir; kayıt saklanmaz.
STT_SAGLAYICI=yok
TTS_SAGLAYICI=yok

# Azure Speech (TTS_SAGLAYICI=azure iken). Anahtar ve bölge, Azure portalında Speech
# kaynağınızın "Keys and Endpoint" sayfasındadır. Bölge örn. westeurope, germanywestcentral.
# Azure hata verirse ya da ulaşılamazsa tarayıcının kendi sesine düşülür.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Görevlinin sesi cinsiyetine göre seçilir (görevli oyun başında rastgele kadın ya da erkek olur).
# Türkçe Neural sesler: kadın tr-TR-EmelNeural, erkek tr-TR-AhmetNeural.
AZURE_SPEECH_SES_KADIN=tr-TR-EmelNeural
AZURE_SPEECH_SES_ERKEK=tr-TR-AhmetNeural
